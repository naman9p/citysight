{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citysight/contracts/events/plate-observation.schema.json",
  "title": "PlateObservation",
  "description": "Canonical Phase 1 ANPR observation consumed by Phase 2. Fields follow the CLAUDE.md Output Contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "camera_id",
    "track_id",
    "timestamp",
    "plate_raw",
    "plate_normalized",
    "confidence",
    "status",
    "detector_confidence",
    "ocr_confidence",
    "quality_score",
    "best_frame_number",
    "plate_image_path",
    "model_version"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "camera_id": { "type": "string", "minLength": 1 },
    "track_id": { "type": "integer" },
    "timestamp": { "type": "string", "minLength": 1 },
    "plate_raw": { "type": ["string", "null"] },
    "plate_normalized": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["accepted", "review", "abstained"] },
    "detector_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "ocr_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "best_frame_number": { "type": ["integer", "null"] },
    "plate_image_path": { "type": ["string", "null"] },
    "model_version": { "type": "string", "minLength": 1 }
  }
}
